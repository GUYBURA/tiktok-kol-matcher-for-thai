APIFY_TOKEN=                      # required for live mode
APIFY_MAX_CONCURRENT_RUNS=4         # Apify memory cap: free plan 16 GB, TikTok run 4 GB
CACHE_PATH=data/cache.duckdb
REPLAY_MODE=false                 # true = serve fixtures only, no external calls
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
MAX_RESULTS_PER_QUERY=30
MAX_CREATORS_PER_EVALUATE=20
CACHE_TTL_HOURS=24FIXTURES_PATH=fixtures             # replay mode loads raw_responses + embeddings parquet from here
PYTHONUTF8=1